{
  "$schema": "https://schema.tauri.app/config/2/capability",
  "identifier": "default",
  "description": "Default capability for QuickEstimate",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [{ "path": "$HOME/**" }, { "path": "/tmp/**" }, { "path": "/**" }]
    },
    "dialog:default",
    "dialog:allow-save",
    "fs:default",
    "shell:default"
  ]
}
